# Copy to .env for local development. Never commit real secrets.
API_KEY=change-me-to-a-long-random-string
LINK_SIGNING_KEY=change-me-to-another-long-random-string-32chars+
LINK_DEFAULT_TTL_SECONDS=900
LINK_MAX_TTL_SECONDS=86400
PUBLIC_BASE_URL=http://localhost:8000
DISPLAY_TIMEZONE=Africa/Johannesburg

# S3-compatible storage (RustFS)
S3_ENDPOINT=localhost:9000
S3_REGION=af-south-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_SECURE=false
S3_BUCKET=downloads
